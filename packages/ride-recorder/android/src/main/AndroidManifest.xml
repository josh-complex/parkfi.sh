<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 50 Hz IMU sampling on API 31+; below that SENSOR_DELAY_GAME is already allowed. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- TYPE_STEP_COUNTER on API 29+ (F-steps: in-park step achievements).
         Runtime-requested via the plugin's "motion" alias; a denial only
         disables step counting, never IMU ride detection. Play Console: this
         triggers the Health apps / physical-activity declaration. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Foreground service keeps capture alive with the screen off (W8). The
         `specialUse` type is the honest fit for continuous novel sensor sampling
         (not location/health/dataSync) and requires a Play Console declaration —
         see FOLLOWUP.md W8. POST_NOTIFICATIONS (API 33+) is needed for the ongoing
         + recap notifications; it's already requested via @capacitor/push-notifications. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Background park geofencing (Tier 1): Play Services geofence transitions
         fire even when the app is killed, but only with the "allow all the time"
         grant on API 29+. Foreground fine-location is already held via the
         WebView geolocation prompt; this adds the background tier, requested
         on demand via the plugin's "bgLocation" alias. Play Console: background
         location triggers its own prominent-disclosure review. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Barometer is optional — many midrange phones lack one; don't exclude them
         from the store. baroAvailable=false degrades drop/vertical metrics gracefully. -->
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application>
        <service
            android:name=".RideMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects roller-coaster rides from motion sensors while the user is in a theme park, to credit ride achievements; runs only while the app has armed monitoring in-park." />
        </service>

        <!-- Receives Play Services geofence transitions (park entry/exit). A plain
             manifest receiver so the OS can deliver even after process death. -->
        <receiver
            android:name=".ParkGeofenceReceiver"
            android:exported="false" />
    </application>

</manifest>
