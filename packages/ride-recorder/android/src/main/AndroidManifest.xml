<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 50 Hz IMU sampling on API 31+; below that SENSOR_DELAY_GAME is already allowed. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- Barometer is optional — many midrange phones lack one; don't exclude them
         from the store. baroAvailable=false degrades drop/vertical metrics gracefully. -->
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

</manifest>
